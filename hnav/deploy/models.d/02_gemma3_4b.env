# gemma-3-4b-it — campaign model 02.                            [E2E-5]
# Sourced by run_model_campaign.sh; see models.d/README.md for the rules.
MODEL_KEY=gemma3_4b
MODEL_PATH=/mnt/nvmes/nvme1/models/gemma-3-4b-it
SERVED_NAME=google/gemma-3-4b-it
VLLM_ENV=legacy                 # Gemma3ForConditionalGeneration is in vllm 0.9.1
# measured: longest sh_64k prompt = 48,224 tokens (3.52 chars/token). This is
# ABOVE 48k, so a 48000-token server would have died mid-campaign on the
# longest question. 56k leaves 16% headroom; the extra KV costs ~0.2 GiB here.
MAX_MODEL_LEN=57344
GPU_MEM_UTIL=0.85
KV_CACHE_DTYPE=fp8
# Text-only benchmark: refuse image items rather than reserve encoder memory
# and profiling capacity for a modality no prompt uses.
EXTRA_SERVE_FLAGS='--limit-mm-per-prompt {"image":0}'
NOTES="4.3B multimodal checkpoint run text-only; 5:1 local/global attention, no thinking mode."
