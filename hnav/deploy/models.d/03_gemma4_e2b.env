# gemma-4-E2B-it — campaign model 03.                           [E2E-5]
# Sourced by run_model_campaign.sh; see models.d/README.md for the rules.
MODEL_KEY=gemma4_e2b
MODEL_PATH=/mnt/nvmes/nvme1/models/gemma-4-E2B-it
SERVED_NAME=google/gemma-4-E2B-it
VLLM_ENV=modern                 # Gemma4ForConditionalGeneration is NOT in 0.9.1
# measured: longest sh_64k prompt = 48,228 tokens (3.52 chars/token), above
# 48k. Same tokenizer family as gemma-3, same value.
MAX_MODEL_LEN=57344
GPU_MEM_UTIL=0.85
# PLAIN fp8, deliberately - NOT fp8_per_token_head / int8_per_token_head. Those
# per-token-head cache modes have documented corruption on Gemma-4 because its
# hybrid attention groups use different head dimensions; ordinary fp8 KV is a
# supported memory optimization. The hardened preflight (unique-stratum
# accuracy floor + repetition detector) runs under this exact configuration
# before any measured cell, and if it trips, establish a clean auto/BF16
# reference with diagnose_serving.sh rather than re-rolling a measured subset.
KV_CACHE_DTYPE=fp8
# --language-model-only zeroes EVERY modality limit. This model carries vision,
# audio AND video config; the earlier hand-written '{"image":0,"audio":0}'
# silently left video at its default. --skip-mm-profiling additionally keeps
# the encoder's profiling allocation out of the KV budget.
# No speculative decoding, no unusual cache quantization: nothing the frozen
# design does not already require.
EXTRA_SERVE_FLAGS='--language-model-only --skip-mm-profiling'
NOTES="~5B raw weights, E2B = effective-2B class; chat template ships as chat_template.jinja (transformers v5 layout)."
